# Copy to .env (never commit it) and replace the password.
# SQL Server requires at least 8 characters with upper case, lower case,
# a digit and a symbol.
MSSQL_SA_PASSWORD=Local_Dev_Only_123!

# Demo auth credential. The value in compose.yaml is the default when this is
# absent; set it here to change the demo password without editing compose.
DEMO_PASSWORD=Demo_Passw0rd!

# A non-demo run must clear the fixed OTP and point at a real SMS gateway:
# DEMO_MODE=false
# DEMO_OTP=
# SMS_PROVIDER_URL=http://your-sms-gateway
