# Copy to .env (never commit it) and replace the passwords.
# SQL Server requires at least 8 characters with upper case, lower case,
# a digit and a symbol.
MSSQL_SA_PASSWORD=Local_Dev_Only_123!

# Application logins created by the one-shot db-grants service and used by the
# auth and api containers. They only receive db_datareader + db_datawriter in
# their own database; they cannot create, alter, or drop anything.
SME_API_DB_PASSWORD=Api_App_Dev_123!
SME_AUTH_DB_PASSWORD=Auth_App_Dev_123!

# Demo credentials. auth accepts exactly these values in demo mode, and the web
# container publishes the same values through its runtime /config.js so the
# sign-in screen can show a hint. DEMO_MODE defaults to false in the service and
# is turned on explicitly by compose.yaml; turning it off hides the hint and
# requires a real SMS gateway. auth also refuses to start while DEMO_OTP is set,
# or while DEMO_USERNAME/DEMO_PASSWORD/DEMO_PHONE still hold these published
# values, so clear or change all of them when setting DEMO_MODE=false.
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo_Passw0rd!
DEMO_OTP=123456
# DEMO_MODE=true

# Optional overrides. The defaults in compose.yaml are suitable for local work.
# ORG_ID=sme
# PUBLIC_BASE_URL=http://localhost:8082
# SEED_ENABLED=true

# Mock issuer API key. Issuer-mock and api must use the same value; the default
# is the demo value in compose.yaml. This is a local demo credential, not a
# secret, but keep it out of committed environment-specific files all the same.
# ISSUER_API_KEY=demo-issuer-key
# ISSUER_BASE_URL=http://issuer-mock:8084
# ISSUER_SYNC_INTERVAL=5m
# ISSUER_SYNC_ENABLED=true

# SMS gateway used by auth. Compose defaults it to the bundled sms-mock, whose
# log is where the demo OTP appears (`docker compose logs sms-mock`). Demo mode
# still sends. A non-demo run must point this at a real gateway and clear the
# fixed OTP (DEMO_OTP=) as well as set DEMO_MODE=false:
# SMS_PROVIDER_URL=http://sms-mock:8083
