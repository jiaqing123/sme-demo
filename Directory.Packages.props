<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    Licensing-pinned. Do not raise these versions without reading
    docs/licensing.md and re-checking the licence terms:
      MediatR 12.5.0      last Apache-2.0 release
      AutoMapper 14.0.0   last MIT release
    MediatR 13+ and AutoMapper 15+ are RPL-1.5 or commercial.
  -->
  <ItemGroup Label="Licensing-pinned">
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="AutoMapper" Version="14.0.0" />
  </ItemGroup>

  <ItemGroup Label="Data access">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

  <!--
    Lifted above the version Microsoft.Data.SqlClient 6.1.7 brings in, because
    that transitive version (9.0.11) trips NuGet audit (GHSA-846f-f764-76mx,
    GHSA-2fmv-rv2c-59x7). Remove this pin when SqlClient ships the fix.
  -->
  <ItemGroup Label="Security pins">
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
