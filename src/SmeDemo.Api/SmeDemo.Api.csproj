<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SmeDemo.Api</RootNamespace>
    <AssemblyName>SmeDemo.Api</AssemblyName>

    <!--
      The generated document is a committed artefact: CI regenerates it during
      the build and fails on any difference, so a route or contract change
      cannot ship without the matching openapi/v1.json update.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmeDemo.Application\SmeDemo.Application.csproj" />
    <ProjectReference Include="..\SmeDemo.Infrastructure\SmeDemo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" />
  </ItemGroup>

</Project>
