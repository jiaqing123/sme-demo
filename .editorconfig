root = true

# The repository is edited on Windows and built on Linux. Sources are UTF-8;
# both the BOM and BOM-less encodings already present are accepted (an explicit
# `charset` would rewrite dozens of existing files for no behavioural gain). Git
# normalises line endings to LF (.gitattributes), and the formatter gate checks
# the same rule.
[*]
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
# Match the style the codebase already uses; the gate is deliberately narrow
# so it enforces consistency without restyling the tree.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
dotnet_diagnostic.IDE0005.severity = warning

# EF-generated migrations are written by the tool with block-scoped namespaces,
# explicit types, and their own header. Treat them as generated so the format
# gate does not fight `dotnet ef migrations add`.
[**/Persistence/Migrations/*.cs]
generated_code = true
csharp_style_namespace_declarations = block_scoped:suggestion

# The OpenAPI document is produced byte-for-byte by the build-time generator,
# which writes no trailing newline. Editing it by hand (or letting an editor add
# one) would fail the CI diff check.
[openapi/*.json]
insert_final_newline = false
